  ).toBeUndefined();
  expect(z.string().catch("X").pipe(z.string()).optional().parse(undefined)).toBeUndefined();
  expect(
    z
      .string()
      .catch("X")
      .transform((s) => s + "!")
      .transform((s) => s.toLowerCase())
      .optional()
      .parse(undefined)
  ).toBeUndefined();
  expect(
    z
      .object({
        a: z
          .string()
          .catch("X")
          .transform((s) => s + "!")
          .optional(),
      })
      .parse({})
  ).toEqual({});

  expect(
    z
      .string()
      .catch("X")
      .transform((s) => s + "!")
      .parse("hi")
  ).toBe("hi!");
  expect(
    z
      .string()
      .catch("X")
      .transform((s) => s + "!")
      .parse(123)
  ).toBe("X!");
});
