    });

    test("transform", () => {
      expectMethodMatch(
        z.string().transform((val) => val.length),
        { unrepresentable: "any" }
      );
    });

    test("file", () => {
      expectMethodMatch(z.file());
    });

    test("file with mime", () => {
      expectMethodMatch(z.file().mime("image/png"));
